// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Users {
  id       Int       @id @default(autoincrement())
  username String
  name     String
  surname  String
  password String
  url_user String

  flowers  Flowers[]
  history  History[]
}

model Flowers {
  id         Int       @id @default(autoincrement())
  name       String
  message    String
  url_flower String
  access_key Int
  user_id    Int

  user       Users     @relation(fields: [user_id], references: [id])
  history    History[]
  meaning    Meaning[]
}

model History {
  id          Int     @id @default(autoincrement())
  flower_id   Int
  user_id     Int?
  view_count  Int @default(0)
  view_at     DateTime

  flower    Flowers @relation(fields: [flower_id], references: [id])
  user      Users?   @relation(fields: [user_id], references: [id])
}

model Meaning {
  id        Int     @id @default(autoincrement())
  mean      String
  flower_id Int

  flower    Flowers @relation(fields: [flower_id], references: [id])
}
